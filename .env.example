# CognoDB (free c0 instance) - https://console.cognodb.com
# Create an instance, copy the bolt+s:// URI and the database password.
# NOTE: the password is shown exactly once at creation time - save it in a
# password manager before closing the console. Do not commit .env.

# The bolt+s:// connection URI of your CognoDB instance, e.g.
# COGNODB_URI=bolt+s://db-xxxx.databases.cognodb.cloud
COGNODB_URI=bolt+s://db-xxxx.databases.cognodb.cloud

# CognoDB username (default is "cognodb", usually fine to leave as-is).
COGNODB_USERNAME=cognodb

# The password shown exactly once when the instance was created.
COGNODB_PASSWORD=your-instance-password

# Optional: demo mode without a database (returns canned sample data from an
# in-memory copy of the seed datasets). Set MOCK_DB=1 to explore the app
# before creating a CognoDB instance.
MOCK_DB=0
